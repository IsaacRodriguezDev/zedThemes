    "icon_theme": {
        "mode": "system",
        "light": "Zed (Default)",
        "dark": "Material Icon Theme",
    },
    "git_panel": {
        "show_count_badge": false,
        "sort_by_path": false,
        "collapse_untracked_diff": false,
        "file_icons": true,
        "tree_view": true,
        "dock": "right",
    },
    "agent": {
        "tool_permissions": {
            "tools": {
                "terminal": {
                    "default": "allow"
                },
                "delete_path": {
                    "always_allow": [
                        {
                            "pattern": "^/Users/jscf/practiceProjects/2026projects/kbanGo/kanbanDB/"
                        }
                    ]
                }
            }
        },
        "sandbox_permissions": {
            "allow_unsandboxed": true,
            "network_hosts": [
                "registry.npmjs.org"
            ]
        },
        "default_model": {
            "provider": "GLM",
            "model": "glm-4.6",
        },
        "dock": "left",
    },
    "project_panel": {
        "git_status": true,
        "git_status_indicator": false,
        "dock": "right",
    },
    "minimap": {
        "show": "never",
    },
    "agent_servers": {
        "OpenCode": {
            "type": "extension",
            "favorite_config_option_values": {
                "model": [
                    "opencode/minimax-m2.5-free",
                    "opencode/ling-2.6-flash-free",
                    "opencode/nemotron-3-super-free",
                    "opencode/nemotron-3-super-free/medium",
                    "opencode/big-pickle",
                ],
            },
        },
    },
    "agent_buffer_font_size": 16.0,
    "agent_ui_font_size": 14.0,
    "inline_code_actions": true,
    "show_completion_documentation": true,
    "vim_mode": true,
    "helix_mode": false,
